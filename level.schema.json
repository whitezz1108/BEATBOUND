{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beatbound.local/schema/level.schema.json",
  "title": "BeatBound Level",
  "type": "object",
  "required": [
    "version",
    "song",
    "sections"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "song": {
      "type": "object",
      "required": [
        "id",
        "audio",
        "bpm",
        "timeSignature"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "audio": {
          "type": "string"
        },
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeSignature": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "enum": [
                2,
                4,
                8,
                16
              ]
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "startBar",
          "lengthBars",
          "mode",
          "patterns"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "startBar": {
            "type": "integer",
            "minimum": 1
          },
          "lengthBars": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "ARENA",
              "RUNNER",
              "VERTICAL",
              "RADIAL",
              "DUO"
            ]
          },
          "function": {
            "type": "string"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "patternId"
              ],
              "properties": {
                "patternId": {
                  "type": "string"
                },
                "repeat": {
                  "type": "integer",
                  "minimum": 1
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "transitionOut": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}