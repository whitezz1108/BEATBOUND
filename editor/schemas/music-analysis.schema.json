{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beatbound.local/editor/music-analysis.schema.json",
  "title": "BeatBound Music Analysis",
  "description": "Output of editor/music-analysis/analyze_music.py. All musical positions are on a constant-tempo grid anchored at audio time 0, so bars here are the same bars the runtime's ConstantTempoMap produces.",
  "type": "object",
  "required": [
    "version",
    "song",
    "tempo",
    "beats",
    "bars",
    "onsets",
    "energyChanges",
    "sections",
    "waveformEnvelope"
  ],
  "properties": {
    "version": { "type": "string" },
    "song": {
      "type": "object",
      "required": ["id", "title", "audioPath", "durationSec", "sampleRate"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "audioPath": { "type": "string" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "sourceHash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tempo": {
      "type": "object",
      "required": ["bpm", "confidence", "timeSignature"],
      "properties": {
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "timeSignature": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "enum": [2, 4, 8, 16] }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "beats": {
      "type": "array",
      "description": "One entry per grid beat, 0-based index, 1-based bar/beat-in-bar.",
      "items": {
        "type": "object",
        "required": ["time", "index", "bar", "beat", "strength"],
        "properties": {
          "time": { "type": "number", "minimum": 0 },
          "index": { "type": "integer", "minimum": 0 },
          "bar": { "type": "integer", "minimum": 1 },
          "beat": { "type": "integer", "minimum": 1 },
          "strength": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "bars": {
      "type": "array",
      "description": "One entry per grid bar with aggregated features the director consumes.",
      "items": {
        "type": "object",
        "required": ["bar", "startTime", "endTime", "energy", "rhythmDensity"],
        "properties": {
          "bar": { "type": "integer", "minimum": 1 },
          "startTime": { "type": "number", "minimum": 0 },
          "endTime": { "type": "number" },
          "rmsMean": { "type": "number", "minimum": 0 },
          "rmsPeak": { "type": "number", "minimum": 0 },
          "onsetCount": { "type": "integer", "minimum": 0 },
          "beatStrength": { "type": "number", "minimum": 0 },
          "energy": { "type": "number", "minimum": 0, "maximum": 1 },
          "rhythmDensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "novelty": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "onsets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "strength"],
        "properties": {
          "time": { "type": "number", "minimum": 0 },
          "strength": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "energyChanges": {
      "type": "array",
      "description": "Major bar-to-bar energy transitions (rises, falls, drops).",
      "items": {
        "type": "object",
        "required": ["time", "bar", "direction", "magnitude"],
        "properties": {
          "time": { "type": "number", "minimum": 0 },
          "bar": { "type": "integer", "minimum": 1 },
          "direction": { "type": "string", "enum": ["rise", "fall"] },
          "magnitude": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "description": "Structural segments from novelty-based boundary detection, snapped to the bar grid. Labels are section_01, section_02, ... — no semantic labels.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "startBar",
          "endBar",
          "startTime",
          "endTime",
          "meanEnergy",
          "peakEnergy",
          "meanRhythmDensity"
        ],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "startBar": { "type": "integer", "minimum": 1 },
          "endBar": { "type": "integer", "minimum": 1 },
          "startTime": { "type": "number", "minimum": 0 },
          "endTime": { "type": "number" },
          "durationSec": { "type": "number", "minimum": 0 },
          "meanEnergy": { "type": "number", "minimum": 0, "maximum": 1 },
          "peakEnergy": { "type": "number", "minimum": 0, "maximum": 1 },
          "meanRhythmDensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "onsetCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "waveformEnvelope": {
      "type": "object",
      "description": "Downsampled amplitude envelope for timeline drawing.",
      "required": ["times", "values"],
      "properties": {
        "times": { "type": "array", "items": { "type": "number" } },
        "values": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      },
      "additionalProperties": false
    },
    "rmsCurve": {
      "type": "object",
      "required": ["times", "values"],
      "properties": {
        "times": { "type": "array", "items": { "type": "number" } },
        "values": { "type": "array", "items": { "type": "number", "minimum": 0 } }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "description": "Human-readable record of the parameters used.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
