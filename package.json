{
  "name": "beatbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BeatBound - data-driven multi-mode rhythm game runtime",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:timing": "esbuild tools/sync-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/beatbound/sync-test.mjs --log-level=warning && node node_modules/.cache/beatbound/sync-test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
