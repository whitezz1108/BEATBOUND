# BeatBound editor -- LLM director configuration.
#
# Copy this file to `.env` (same directory) and fill in your key.
# `.env` is gitignored; this example is not, so it must never hold a real key.
#
# Only layer 3 (the AI level director) needs a key. Analysis, director context,
# compilation and validation all run without one -- and a generation from a
# supplied blueprint is fully offline.

# ---- ParaRater / 并行智算云 (OpenAI-compatible) ----------------------------
# Host is llmapi.paratera.com. Note that `openapi.paratera.com` -- which some
# copies of their docs show -- does not resolve in DNS at all.
BEATBOUND_LLM_PROVIDER=openai_compatible
BEATBOUND_LLM_BASE_URL=https://llmapi.paratera.com/v1
BEATBOUND_LLM_MODEL=DeepSeek-V4.1-Flash
BEATBOUND_LLM_API_KEY=

# ---- DeepSeek's own API (the default) --------------------------------------
# BEATBOUND_LLM_PROVIDER=deepseek
# BEATBOUND_LLM_BASE_URL=https://api.deepseek.com/v1
# BEATBOUND_LLM_MODEL=deepseek-chat
# BEATBOUND_LLM_API_KEY=

# ---- Optional --------------------------------------------------------------
# BEATBOUND_LLM_TIMEOUT_MS=120000
# BEATBOUND_LLM_MAX_TOKENS=8192
# BEATBOUND_LLM_REASONING_EFFORT=medium
